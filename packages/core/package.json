{
  "name": "retrace-core",
  "version": "0.1.0",
  "description": "Core event schema, hash-chained store, and transcript parser for Retrace, a flight recorder for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "retrace",
    "claude-code",
    "ai-agent",
    "observability"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  }
}
