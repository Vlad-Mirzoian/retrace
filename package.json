{
  "name": "retrace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vlad-Mirzoian/retrace.git"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "pnpm --filter retrace-core run build && pnpm --filter @retrace/viewer run build && pnpm --filter retrace-cli run build",
    "test": "pnpm -r run test",
    "verify:pack": "node scripts/verify-tarball.mjs",
    "check:corpus": "node scripts/check-corpus.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.4"
  }
}