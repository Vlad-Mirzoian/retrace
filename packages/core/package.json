{
  "name": "retrace-core",
  "version": "0.3.0",
  "description": "Core event schema, hash-chained store, transcript parser, and check engine for Retrace — verifies whether a Claude Code session did what it claimed.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "retrace",
    "claude-code",
    "ai-agent",
    "observability",
    "code-review",
    "audit",
    "verification",
    "agent"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vlad-Mirzoian/retrace.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Vlad-Mirzoian/retrace#readme",
  "bugs": {
    "url": "https://github.com/Vlad-Mirzoian/retrace/issues"
  },
  "author": "Ukra1n1anUnd3rd0g",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  }
}
